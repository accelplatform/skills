<settings xmlns="http://maven.apache.org/POM/4.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <profiles>
    <profile>
      <id>intra-mart</id>

      <repositories>
        <repository>
          <id>intra-mart-maven</id>
          <url>https://maven.intra-mart.jp/</url>
        </repository>

        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2/</url>
        </repository>
      </repositories>

      <pluginRepositories>
        <pluginRepository>
          <id>intra-mart-maven</id>
          <url>https://maven.intra-mart.jp/</url>
        </pluginRepository>
        <pluginRepository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2/</url>
        </pluginRepository>
      </pluginRepositories>

    </profile>
  </profiles>

  <pluginGroups>
    <pluginGroup>jp.co.intra_mart.harness</pluginGroup>
  </pluginGroups>

  <activeProfiles>
    <activeProfile>intra-mart</activeProfile>
  </activeProfiles>
</settings>