{
  "version": "1.0.0",
  "type": "file",
  "conditions": {
    "accelplatformVersion": ">=8.0.37"
  },
  "rename": [
    {
      "condition": {
        "locale": "ja"
      },
      "from": "copilot-instructions_ja.md",
      "to": "copilot-instructions.md"
    },
    {
      "condition": {
        "locale": "en"
      },
      "from": "copilot-instructions_en.md",
      "to": "copilot-instructions.md"
    },
    {
      "condition": {
        "locale": "zh_CN"
      },
      "from": "copilot-instructions_zh_CN.md",
      "to": "copilot-instructions.md"
    }
  ],
  "replacements": [
    {
      "type": "text",
      "target": "{{AGENT_RULES}}",
      "values": [
        {
          "condition": {
            "agent": "github-copilot"
          },
          "value": "rules"
        },
        {
          "condition": {
            "agent": "github-copilot"
          },
          "value": "instructions"
        },
        {
          "condition": {
            "agent": "codex"
          },
          "value": "requirements"
        }
      ]
    }
  ]
}
