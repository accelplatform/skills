{
  "version": "1.0.0",
  "type": "file",
  "conditions": {
    "accelplatformVersion": ">=8.0.37"
  },
  "rename": [
    {
      "condition": {
        "locale": "ja"
      },
      "from": "jssp-im-job-generator.agent_ja.md",
      "to": "jssp-im-job-generator.agent.md"
    },
    {
      "condition": {
        "locale": "en"
      },
      "from": "jssp-im-job-generator.agent_en.md",
      "to": "jssp-im-job-generator.agent.md"
    },
    {
      "condition": {
        "locale": "zh_CN"
      },
      "from": "jssp-im-job-generator.agent_zh_CN.md",
      "to": "jssp-im-job-generator.agent.md"
    }
  ],
  "replacements": [
    {
      "type": "text",
      "target": "{{AGENT_ROOT}}",
      "values": [
        {
          "condition": {
            "agent": "claude-code"
          },
          "value": ".claude"
        },
        {
          "condition": {
            "agent": "github-copilot"
          },
          "value": ".github"
        },
        {
          "condition": {
            "agent": "codex"
          },
          "value": ".codex"
        }
      ]
    }
  ]
}
