{
  "version": "1.0.0",
  "type": "directory",
  "conditions": {
    "and": [
      {
        "accelplatformVersion": ">=8.0.37"
      },
      {
        "module": "im_activiti"
      }
    ]
  },
  "replacements": [
    {
      "type": "regex",
      "pattern": "\\{\\{RUNTIME\\}\\}",
      "replacement": "bun",
      "condition": {
        "packageManager": "bun"
      }
    },
    {
      "type": "regex",
      "pattern": "\\{\\{RUNTIME\\}\\}",
      "replacement": "node",
      "condition": {
        "or": [
          {
            "packageManager": "npm"
          },
          {
            "packageManager": "yarn"
          },
          {
            "packageManager": "pnpm"
          }
        ]
      }
    }
  ]
}