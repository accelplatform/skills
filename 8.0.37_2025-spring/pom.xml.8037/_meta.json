{
  "version": "1.0.0",
  "type": "file",
  "conditions": {
    "accelplatformVersion": "8.0.37"
  },
  "replacements": [
    {
      "type": "foreach",
      "target": "{{DEPENDENCIES}}",
      "items": "modules",
      "template": "<dependency>\n      <groupId>{{$item.groupId}}</groupId>\n      <artifactId>{{$item.artifactId}}</artifactId>\n    </dependency>",
      "separator": "\n    "
    },
    {
      "type": "regex",
      "pattern": "\\{\\{GROUP_ID\\}\\}",
      "replacement": "{{$group}}"
    },
    {
      "type": "regex",
      "pattern": "\\{\\{ARTIFACT_ID\\}\\}",
      "replacement": "{{$artifactId}}"
    },
    {
      "type": "regex",
      "pattern": "\\{\\{PROJECT_NAME\\}\\}",
      "replacement": "{{$name}}"
    },
    {
      "type": "regex",
      "pattern": "\\{\\{PROJECT_VERSION\\}\\}",
      "replacement": "{{$projectVersion}}"
    },
    {
      "type": "regex",
      "pattern": "\\{\\{XML-VALIDATOR-MAVEN-PLUGIN-VERSION\\}\\}",
      "replacement": "1.1.0"
    },
    {
      "type": "regex",
      "pattern": "\\{\\{JAVA-FORMATTER-MAVEN-PLUGIN-VERSION\\}\\}",
      "replacement": "1.1.0"
    },
    {
      "type": "regex",
      "pattern": "\\{\\{JS-JEST-MAVEN-PLUGIN-VERSION\\}\\}",
      "replacement": "1.0.0"
    }
  ],
  "rename": [
    {
      "from": "pom.xml",
      "to": "pom.xml"
    }
  ]
}
