#!/usr/bin/env bash
#
# pre-commit:
#   A hook script that scans the staged changes for strings resembling
#   sensitive information, and blocks the commit if any are detected.
#
# How to enable:
#   chmod +x .githooks/pre-commit
#   git config core.hooksPath .githooks
#
set -euo pipefail
shopt -s nocasematch

# =============================================================================
# Collect the diff
# =============================================================================

# Collect the diff in a single call, since calling git diff once per file
# would be extremely slow when many files are staged.
# The detection scope below is narrow, so the target files are filtered
# ahead of time via git's pathspec:
# - mcp config files (.json / .toml) where intra-mart OAuth client keys are written
diff_output=$(git diff --cached -U0 --diff-filter=ACM -- '*.json' '*.toml' 2>/dev/null | tr -d '\0' || true)
if [ -z "$diff_output" ]; then
  exit 0
fi

found=0
findings=()

# =============================================================================
# base64 decoding functions
# =============================================================================

# On environments where fork/exec is expensive (e.g. Git Bash on Windows),
# spawning a process per candidate token would slow the check down as the
# number of candidates grows, so base64 decoding is done with bash builtins
# only, without spawning external processes (base64/tr).
# To also work on stock /bin/bash 3.2 (still the default shipped on macOS),
# associative arrays (bash 4.0+) are avoided in favor of plain string search
# for the character-to-value lookup.
B64_ALPHABET="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# Sets the 6-bit value of the given base64 character into B64_LAST_VAL.
# If not found, clears B64_LAST_VAL and returns 1.
_b64_char_value() {
  case "$1" in
    -) B64_LAST_VAL=62; return 0 ;;
    _) B64_LAST_VAL=63; return 0 ;;
  esac
  local idx="${B64_ALPHABET%%"$1"*}"
  if [ "$idx" = "$B64_ALPHABET" ]; then
    B64_LAST_VAL=""
    return 1
  fi
  B64_LAST_VAL=${#idx}
  return 0
}

# Decodes the token string as base64 (urlsafe alphabet accepted too), and
# returns true if the decoded result consists only of the alphanumeric
# characters and symbols used in an intra-mart OAuth client key
# (a hex string + '@' + tenant ID).
decode_contains_at() {
  local token="$1"
  local len=${#token}
  # Declare all locals up front instead of re-declaring them on every loop
  # iteration, to avoid the repeated `local` overhead.
  local i=0 has_at=1 c0 c1 c2 c3 v0 v1 v2 v3 nbytes val b1 b2 b3

  while (( i < len )); do
    # base64 restores "3 bytes (8bit x 3)" from "4 characters (6bit x 4)",
    # so the token is processed 4 characters at a time from the start.
    c0="${token:i:1}"; c1="${token:i+1:1}"; c2="${token:i+2:1}"; c3="${token:i+3:1}"
    [[ -z "$c0" || -z "$c1" ]] && break

    # Convert each character to its position in the base64 alphabet
    # (a 6-bit value, 0-63).
    _b64_char_value "$c0" || return 1
    v0=$B64_LAST_VAL
    _b64_char_value "$c1" || return 1
    v1=$B64_LAST_VAL

    # If the 3rd/4th character is padding ("=") or absent, the number of
    # bytes that can be restored from this group is less than 3
    # (only the last group of a base64 string can restore 2 or 1 bytes).
    nbytes=3; v2=0; v3=0
    if [[ -z "$c2" || "$c2" == "=" ]]; then
      nbytes=1
    else
      _b64_char_value "$c2" || return 1
      v2=$B64_LAST_VAL
      if [[ -z "$c3" || "$c3" == "=" ]]; then
        nbytes=2
      else
        _b64_char_value "$c3" || return 1
        v3=$B64_LAST_VAL
      fi
    fi

    # Combine the four 6-bit values (v0-v3, 24 bits total) into a single
    # integer, then split it back into three 8-bit bytes to restore the
    # original byte sequence.
    #   6bit x 4 = [v0][v1][v2][v3] -> 8bit x 3 = [b1][b2][b3]
    val=$(( (v0 * 262144) + (v1 * 4096) + (v2 * 64) + v3 ))
    b1=$(( (val / 65536) % 256 ))

    # If a byte value that is never used in an intra-mart OAuth client key
    # is found, skip further evaluation to avoid a false positive.
    (( (b1 >= 48 && b1 <= 57) || (b1 >= 65 && b1 <= 90) || (b1 >= 97 && b1 <= 122) || b1 == 64 || b1 == 95 || b1 == 45 )) || return 1

    # If the 1st byte is "@" (64 in decimal), this may be an intra-mart
    # OAuth client key, so set has_at to 0.
    (( b1 == 64 )) && has_at=0

    # Apply the same check to the 2nd/3rd byte as for b1.
    # If only 1 byte can be restored from this group (nbytes=1), b2/b3
    # don't exist, so the check itself is skipped based on nbytes.
    if (( nbytes >= 2 )); then
      b2=$(( (val / 256) % 256 ))
      (( (b2 >= 48 && b2 <= 57) || (b2 >= 65 && b2 <= 90) || (b2 >= 97 && b2 <= 122) || b2 == 64 || b2 == 95 || b2 == 45 )) || return 1
      (( b2 == 64 )) && has_at=0
    fi
    if (( nbytes >= 3 )); then
      b3=$(( val % 256 ))
      (( (b3 >= 48 && b3 <= 57) || (b3 >= 65 && b3 <= 90) || (b3 >= 97 && b3 <= 122) || b3 == 64 || b3 == 95 || b3 == 45 )) || return 1
      (( b3 == 64 )) && has_at=0
    fi

    # Once a group restoring fewer than 3 bytes appears, that is the end of
    # the token (it was padded), so the loop is exited. Otherwise, advance
    # to the next 4 characters.
    (( nbytes < 3 )) && break
    i=$((i + 4))
  done

  # Reaching here means the whole token was scanned, so the string consists
  # only of alphanumeric characters and symbols. If "@" was found along the
  # way, has_at=0 (success), and that value is returned as-is.
  return "$has_at"
}

# =============================================================================
# Function that checks base64-like tokens in added lines
# =============================================================================

# Cache of decode results to avoid re-decoding the same token.
# Caches the result of passing the candidate string to decode_contains_at(),
# keyed by the token string itself. Associative arrays (bash 4.0+) are not used.
TOKENS_MATCHED=$'\x01'
TOKENS_UNMATCHED=$'\x01'

# Extracts every base64-like token of 40+ characters from a single added
# line using a regex, and passes each token to decode_contains_at() to judge
# whether it looks like an intra-mart OAuth client key. If so, appends the
# finding to findings and sets found=1.
check_base64_tokens() {
  local file="$1" lineno="$2" content="$3"
  # A candidate token cannot exist below 40 characters, so bail out before
  # entering the regex loop.
  (( ${#content} < 40 )) && return
  local remaining="$content" token is_match

  # Extract candidate tokens using bash's built-in regex matching only
  # (spawning a grep subprocess per line would be extremely slow when many
  # files are changed).
  while [[ "$remaining" =~ ([A-Za-z0-9+/_-]{40,}={0,2}) ]]; do
    token="${BASH_REMATCH[1]}"
    remaining="${remaining#*"$token"}"

    # The same token can appear across multiple files/lines (e.g. the same
    # config copied to multiple places), so the judgment result is cached
    # and reused, while still recording a finding for every occurrence.
    if [[ "$TOKENS_MATCHED" == *$'\x01'"$token"$'\x01'* ]]; then
      is_match=0
    elif [[ "$TOKENS_UNMATCHED" == *$'\x01'"$token"$'\x01'* ]]; then
      is_match=1
    elif decode_contains_at "$token"; then
      TOKENS_MATCHED+="$token"$'\x01'
      is_match=0
    else
      TOKENS_UNMATCHED+="$token"$'\x01'
      is_match=1
    fi

    if (( is_match == 0 )); then
      findings+=("[$file:$lineno] Found an intra-mart OAuth client key string: ${token:0:12}...")
      found=1
    fi
  done
}

# =============================================================================
# Check every line of the diff
# =============================================================================

# The detection scope below is narrow, so only the following extensions are
# targeted:
# - mcp config files (.json / .toml) where intra-mart OAuth client keys are written
INCLUDE_FILE_RE='\.(json|toml)$'

# Dependency lock files and minified build artifacts are unlikely to contain
# secrets, and their many hash-like strings are easily mistaken for auth
# keys, so they are excluded from scanning.
EXCLUDE_FILE_RE='(^|/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|bun\.lock|composer\.lock|Cargo\.lock|Gemfile\.lock)$|\.(min\.js|min\.css|map)$'

current_file=""
current_line=0
is_binary=0
skip_file=0

while IFS= read -r line; do
  case "$line" in
    "diff --git "*)
      # e.g. diff --git a/path/to/file b/path/to/file
      current_file="${line#diff --git a/}"
      current_file="${current_file%% b/*}"
      is_binary=0
      if [[ "$current_file" =~ $INCLUDE_FILE_RE ]] && [[ ! "$current_file" =~ $EXCLUDE_FILE_RE ]]; then
        skip_file=0
      else
        skip_file=1
      fi
      ;;
    "Binary files "*|"GIT binary patch"*)
      is_binary=1
      ;;
    "@@ "*)
      # e.g. @@ -12,0 +13,2 @@ ...  -> get the starting line number (13) on the new-file side
      if [[ "$line" =~ \+([0-9]+) ]]; then
        current_line="${BASH_REMATCH[1]}"
      fi
      ;;
    "+++ "*|"--- "*)
      : # ignore diff header lines
      ;;
    "+"*)
      if (( is_binary == 1 || skip_file == 1 )); then
        continue
      fi
      content="${line#+}"
      check_base64_tokens "$current_file" "$current_line" "$content"
      current_line=$((current_line + 1))
      ;;
    *)
      : ;;
  esac
done <<< "$diff_output"

# =============================================================================
# Display the detection results
# =============================================================================

if [ "$found" -eq 1 ]; then
  echo "----------------------------------------------------------------------"
  echo "🚫 Commit blocked: strings resembling sensitive information were detected"
  echo "----------------------------------------------------------------------"
  for msg in "${findings[@]}"; do
    echo " - $msg"
  done
  echo ""
  echo "The locations above may contain strings resembling sensitive information."
  echo "Please review the content before committing, and remove or replace it if needed."
  echo "If this detection is not an issue, bypass it with: git commit --no-verify"
  exit 1
fi

exit 0
