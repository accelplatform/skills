<?xml version="1.0" encoding="UTF-8"?>
<!--
  IM-Workflow import XML - descriptive XSD 1.1 schema.

  このスキーマは base-im-workflow-generator スキル内のリファレンスおよび
  サンプル XML (sample-complete-branch.md 等) から観察的に作成された
  記述的スキーマであり、IM-Workflow 公式の規範スキーマではありません。

  方針:
    - ハイブリッド: 骨格は厳格、判明している列挙値は厳格、
      未解明の object 配下キーは xs:any processContents="lax" で逃がす。
    - targetNamespace は付けない (サンプル XML が無名前空間のため)。
    - XSD 1.1 を使用。
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified"
           vc:minVersion="1.1"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning">

  <!-- ============================================================ -->
  <!-- 共通 simpleType                                              -->
  <!-- ============================================================ -->

  <!-- value@type 列挙 -->
  <xs:simpleType name="ValueType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="array"/>
      <xs:enumeration value="object"/>
      <xs:enumeration value="string"/>
      <xs:enumeration value="number"/>
      <xs:enumeration value="boolean"/>
      <xs:enumeration value="null"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 汎用スカラ要素用の type 属性 (string / number / boolean / null) -->
  <xs:simpleType name="ScalarType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="string"/>
      <xs:enumeration value="number"/>
      <xs:enumeration value="boolean"/>
      <xs:enumeration value="null"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 配列型用の type 属性 -->
  <xs:simpleType name="ArrayTypeAttr">
    <xs:restriction base="xs:string">
      <xs:enumeration value="array"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- object 型用の type 属性 (null 許容) -->
  <xs:simpleType name="ObjectOrNullTypeAttr">
    <xs:restriction base="xs:string">
      <xs:enumeration value="object"/>
      <xs:enumeration value="null"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ロケール (標準: en, ja, zh_CN。任意ロケールも許容) -->
  <xs:simpleType name="LocaleId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z]{2}(_[A-Z]{2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ノード種別 (ルート定義内の文字列コード) -->
  <xs:simpleType name="NodeTypeName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="nodeTyp_Start"/>
      <xs:enumeration value="nodeTyp_End"/>
      <xs:enumeration value="nodeTyp_Apply"/>
      <xs:enumeration value="nodeTyp_Approve"/>
      <xs:enumeration value="nodeTyp_Dynamic"/>
      <xs:enumeration value="nodeTyp_System"/>
      <xs:enumeration value="nodeTyp_Confirm"/>
      <xs:enumeration value="nodeTyp_Sync_Start"/>
      <xs:enumeration value="nodeTyp_Sync_End"/>
      <xs:enumeration value="nodeTyp_Branch_Start"/>
      <xs:enumeration value="nodeTyp_Branch_End"/>
      <xs:enumeration value="nodeTyp_Horizontal"/>
      <xs:enumeration value="nodeTyp_Vertical"/>
      <xs:enumeration value="nodeTyp_Template"/>
      <xs:enumeration value="nodeTyp_Template_Start"/>
      <xs:enumeration value="nodeTyp_Template_End"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ノード種別 (数値コード; フロー定義・プラグイン内) -->
  <xs:simpleType name="NodeTypeCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
      <xs:enumeration value="2"/>
      <xs:enumeration value="3"/>
      <xs:enumeration value="4"/>
      <xs:enumeration value="5"/>
      <xs:enumeration value="6"/>
      <xs:enumeration value="7"/>
      <xs:enumeration value="8"/>
      <xs:enumeration value="9"/>
      <xs:enumeration value="10"/>
      <xs:enumeration value="11"/>
      <xs:enumeration value="12"/>
      <xs:enumeration value="13"/>
      <xs:enumeration value="14"/>
      <xs:enumeration value="15"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NodeVariety">
    <xs:restriction base="xs:string">
      <xs:enumeration value="system"/>
      <xs:enumeration value="human"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- AttributeType (0..13) と "NoSetting" -->
  <xs:simpleType name="AttributeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
      <xs:enumeration value="2"/>
      <xs:enumeration value="3"/>
      <xs:enumeration value="4"/>
      <xs:enumeration value="5"/>
      <xs:enumeration value="6"/>
      <xs:enumeration value="7"/>
      <xs:enumeration value="8"/>
      <xs:enumeration value="9"/>
      <xs:enumeration value="10"/>
      <xs:enumeration value="11"/>
      <xs:enumeration value="12"/>
      <xs:enumeration value="13"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AttributeKey">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NoSetting"/>
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
      <xs:enumeration value="2"/>
      <xs:enumeration value="3"/>
      <xs:enumeration value="4"/>
      <xs:enumeration value="5"/>
      <xs:enumeration value="6"/>
      <xs:enumeration value="7"/>
      <xs:enumeration value="8"/>
      <xs:enumeration value="9"/>
      <xs:enumeration value="10"/>
      <xs:enumeration value="11"/>
      <xs:enumeration value="12"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VersionStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
      <xs:enumeration value="9"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PageType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
      <xs:enumeration value="2"/>
      <xs:enumeration value="3"/>
      <xs:enumeration value="4"/>
      <xs:enumeration value="5"/>
      <xs:enumeration value="6"/>
      <xs:enumeration value="7"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 権限プラグインの targetType -->
  <xs:simpleType name="TargetType">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="user"/>
      <xs:enumeration value="department"/>
      <xs:enumeration value="post"/>
      <xs:enumeration value="role"/>
      <xs:enumeration value="publicGroup"/>
      <xs:enumeration value="publicGroupRole"/>
      <xs:enumeration value="departmentAndPost"/>
      <xs:enumeration value="departmentAndRole"/>
      <xs:enumeration value="publicGroupAndPublicGroupRole"/>
      <xs:enumeration value="publicGroupAndRole"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 権限プラグインのサフィックスを pluginId 末尾にもつ正規表現 -->
  <xs:simpleType name="AuthorityPluginId">
    <xs:restriction base="xs:string">
      <xs:pattern value="jp\.co\.intra_mart\.workflow\.plugin\.authority\..*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 拡張ポイント (authority) -->
  <xs:simpleType name="AuthorityExtensionPointId">
    <xs:restriction base="xs:string">
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.authority.node.apply"/>
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.authority.node.approve"/>
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.authority.node.approve.static"/>
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.authority.node.dynamic"/>
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.authority.node.confirm"/>
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.authority.administrator.flow.handle"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- コンテンツプラグインの拡張ポイント -->
  <xs:simpleType name="ContentsExtensionPointId">
    <xs:restriction base="xs:string">
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.event.node.action.process"/>
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.event.node.branch.rule"/>
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.event.matter.end.process"/>
      <xs:enumeration value="jp.co.intra_mart.workflow.plugin.event.matter.end_no_transaction.process"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 通知テンプレートの mailId 列挙 -->
  <xs:simpleType name="MailId">
    <xs:restriction base="xs:string">
      <xs:enumeration value="act"/>
      <xs:enumeration value="autopress"/>
      <xs:enumeration value="confirm"/>
      <xs:enumeration value="negotiation"/>
      <xs:enumeration value="processing"/>
      <xs:enumeration value="reference"/>
      <xs:enumeration value="result"/>
      <xs:enumeration value="targetchange"/>
      <xs:enumeration value="transfer"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- list_pattern listPageType -->
  <xs:simpleType name="ListPageType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
      <xs:enumeration value="2"/>
      <xs:enumeration value="3"/>
      <xs:enumeration value="4"/>
      <xs:enumeration value="5"/>
      <xs:enumeration value="6"/>
      <xs:enumeration value="7"/>
      <xs:enumeration value="8"/>
      <xs:enumeration value="9"/>
      <xs:enumeration value="25"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================ -->
  <!-- 汎用 value ラッパ (ゆるい)                                   -->
  <!-- ============================================================ -->

  <!-- 任意の value: type 属性で分岐。lax で中身は自由。                -->
  <xs:complexType name="AnyValue" mixed="true">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="ValueType" use="required"/>
  </xs:complexType>

  <xs:element name="value" type="AnyValue"/>

  <!-- ============================================================ -->
  <!-- 共通 object フィールドの宣言 (判明分のみ厳格、残りは xs:any)  -->
  <!-- ============================================================ -->

  <!-- 代表的な "id / 名称 / localeId / コード" 系要素 (ScalarType) -->
  <xs:group name="KnownScalarFields">
    <xs:choice>
      <xs:element name="localeId" type="ScalarLocaleId"/>
      <xs:element name="contentsId" type="ScalarIdString"/>
      <xs:element name="contentsVersionId" type="ScalarIdString"/>
      <xs:element name="contentsName" type="ScalarString"/>
      <xs:element name="contentsType" type="ScalarString"/>
      <xs:element name="contentsPluginId" type="ScalarIdString"/>
      <xs:element name="contentsRuleId" type="ScalarIdString"/>
      <xs:element name="routeId" type="ScalarIdString"/>
      <xs:element name="routeVersionId" type="ScalarIdString"/>
      <xs:element name="routeName" type="ScalarString"/>
      <xs:element name="routeType" type="ScalarString"/>
      <xs:element name="routePluginId" type="ScalarIdString"/>
      <xs:element name="routeFilePath" type="ScalarString"/>
      <xs:element name="routeTemplateId" type="ScalarString"/>
      <xs:element name="routeTemplateName" type="ScalarString"/>
      <xs:element name="flowId" type="ScalarIdString"/>
      <xs:element name="flowVersionId" type="ScalarIdString"/>
      <xs:element name="flowName" type="ScalarString"/>
      <xs:element name="nodeId" type="ScalarIdString"/>
      <xs:element name="nodeName" type="ScalarString"/>
      <xs:element name="nodeType" type="ScalarString"/>
      <xs:element name="nodeVariety" type="ScalarString"/>
      <xs:element name="startDate" type="ScalarString"/>
      <xs:element name="limitDate" type="ScalarString"/>
      <xs:element name="versionStatus" type="ScalarString"/>
      <xs:element name="updateCount" type="ScalarString"/>
      <xs:element name="note" type="ScalarString"/>
      <xs:element name="pageName" type="ScalarString"/>
      <xs:element name="pagePathId" type="ScalarIdString"/>
      <xs:element name="pageType" type="ScalarString"/>
      <xs:element name="defaultFlag" type="ScalarString"/>
      <xs:element name="pathType" type="ScalarString"/>
      <xs:element name="scriptPath" type="ScalarString"/>
      <xs:element name="applicationId" type="ScalarString"/>
      <xs:element name="serviceId" type="ScalarString"/>
      <xs:element name="pagePath" type="ScalarString"/>
      <xs:element name="exPointId" type="ScalarString"/>
      <xs:element name="extensionPointId" type="ScalarString"/>
      <xs:element name="pluginId" type="ScalarString"/>
      <xs:element name="pluginName" type="ScalarString"/>
      <xs:element name="parameter" type="ScalarString"/>
      <xs:element name="targetType" type="ScalarString"/>
      <xs:element name="targetCode" type="ScalarString"/>
      <xs:element name="executeOrder" type="ScalarString"/>
      <xs:element name="startNodeFlag" type="ScalarString"/>
      <xs:element name="endNodeFlag" type="ScalarString"/>
      <xs:element name="traceId" type="ScalarString"/>
      <xs:element name="x" type="ScalarString"/>
      <xs:element name="y" type="ScalarString"/>
      <xs:element name="parentNode" type="ScalarString"/>
      <xs:element name="lumpProcessFlag" type="ScalarString"/>
      <xs:element name="attachFileFlag" type="ScalarString"/>
      <xs:element name="autoProcessFlag" type="ScalarString"/>
      <xs:element name="autoProcessLimitDay" type="ScalarString"/>
      <xs:element name="autoProcessLimitType" type="ScalarString"/>
      <xs:element name="autoPressFlag" type="ScalarString"/>
      <xs:element name="autoPressLimitDay" type="ScalarString"/>
      <xs:element name="attributeType" type="ScalarAttributeType"/>
      <xs:element name="attributeKey" type="ScalarAttributeKey"/>
      <xs:element name="no" type="ScalarString"/>
      <xs:element name="cooperationType" type="ScalarString"/>
      <xs:element name="cooperationClassify" type="ScalarString"/>
      <xs:element name="cooperationId" type="ScalarIdString"/>
      <xs:element name="emptyFlag" type="ScalarString"/>
      <xs:element name="branchUnionId" type="ScalarString"/>
      <xs:element name="branchUnionGroupId" type="ScalarString"/>
      <xs:element name="branchUnionGroupClassify" type="ScalarString"/>
      <xs:element name="countTrue" type="ScalarString"/>
      <xs:element name="countTargetNodeId" type="ScalarString"/>
      <xs:element name="ruleId" type="ScalarIdString"/>
      <xs:element name="ruleName" type="ScalarString"/>
      <xs:element name="ruleUnionCondition" type="ScalarString"/>
      <xs:element name="compareRuleId" type="ScalarString"/>
      <xs:element name="compareVariable" type="ScalarString"/>
      <xs:element name="conditionValue" type="ScalarString"/>
      <xs:element name="conditionValueType" type="ScalarString"/>
      <xs:element name="matterPropertyKey" type="ScalarString"/>
      <xs:element name="matterPropertyName" type="ScalarString"/>
      <xs:element name="matterPropertyModelType" type="ScalarString"/>
      <xs:element name="matterPropertyTypeListPattern" type="ScalarString"/>
      <xs:element name="matterPropertyTypeMailTemplate" type="ScalarString"/>
      <xs:element name="matterPropertyTypeImBoxTpl" type="ScalarString"/>
      <xs:element name="matterPropertyTypeRule" type="ScalarString"/>
      <xs:element name="alignType" type="ScalarString"/>
      <xs:element name="searchRangeType" type="ScalarString"/>
      <xs:element name="commaSeparatedFlag" type="ScalarString"/>
      <xs:element name="calendarFlag" type="ScalarString"/>
      <xs:element name="ruleData" type="ScalarString"/>
      <xs:element name="mailId" type="ScalarString"/>
      <xs:element name="imBoxId" type="ScalarString"/>
      <!-- 追加: flow details で観察されたフラグ・ID 群 -->
      <xs:element name="lumpConfirmFlag" type="ScalarString"/>
      <xs:element name="confirmUserSetupFlag" type="ScalarString"/>
      <xs:element name="completeMatterConfirmFlag" type="ScalarString"/>
      <xs:element name="asyncProcessFlag" type="ScalarString"/>
      <xs:element name="sysDateTargetExpandFlag" type="ScalarString"/>
      <xs:element name="calendarId" type="ScalarString"/>
      <xs:element name="enabledContentsId" type="ScalarString"/>
      <xs:element name="enabledRouteId" type="ScalarString"/>
      <!-- 追加: flow nodes で観察される route ノードへの参照 -->
      <xs:element name="routeNode" type="ScalarString"/>
      <xs:element name="listPageType" type="ScalarString"/>
    </xs:choice>
  </xs:group>

  <!-- scalar: 任意文字列 + type 属性 (string/number/boolean/null) -->
  <xs:complexType name="ScalarString" mixed="true">
    <xs:sequence/>
    <xs:attribute name="type" type="ScalarType" use="required"/>
  </xs:complexType>

  <!-- scalar: ID文字列（20文字以内）-->
  <xs:simpleType name="IdString20">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ScalarIdString">
    <xs:simpleContent>
      <xs:extension base="IdString20">
        <xs:attribute name="type" type="ScalarType" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- scalar: ロケールID + type 属性 -->
  <xs:complexType name="ScalarLocaleId">
    <xs:simpleContent>
      <xs:extension base="LocaleId">
        <xs:attribute name="type" type="ScalarType" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- scalar: AttributeType + type 属性 -->
  <xs:complexType name="ScalarAttributeType">
    <xs:simpleContent>
      <xs:extension base="AttributeType">
        <xs:attribute name="type" type="ScalarType" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- scalar: AttributeKey + type 属性 -->
  <xs:complexType name="ScalarAttributeKey">
    <xs:simpleContent>
      <xs:extension base="AttributeKey">
        <xs:attribute name="type" type="ScalarType" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- string スカラのみを要素に持つ array -->
  <xs:complexType name="ScalarStringArray">
    <xs:sequence>
      <xs:element name="value" type="ScalarString" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="ArrayTypeAttr" use="required"/>
  </xs:complexType>

  <!-- 汎用 array: value の繰り返し -->
  <xs:complexType name="GenericArray">
    <xs:sequence>
      <xs:element ref="value" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="ArrayTypeAttr" use="required"/>
  </xs:complexType>

  <!-- 汎用 object: lax フォールバック (XSD 1.0 UPA 違反を避けるため     -->
  <!-- 名前付き要素と xs:any を混在させず、pure any とする)              -->
  <xs:complexType name="GenericObject">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="ObjectOrNullTypeAttr" use="required"/>
  </xs:complexType>

  <!-- ============================================================ -->
  <!-- data ルート                                                  -->
  <!-- ============================================================ -->

  <xs:element name="data">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="contents"/>
        <xs:element ref="route"/>
        <xs:element ref="flow"/>
        <xs:element ref="matter_property"/>
        <xs:element ref="rule"/>
        <xs:element ref="mail"/>
        <xs:element ref="imBox"/>
        <xs:element ref="list_pattern"/>
        <xs:element ref="message_template"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <!-- ============================================================ -->
  <!-- 汎用: 未記述セクション用                                     -->
  <!-- ============================================================ -->

  <xs:complexType name="GenericSectionType">
    <xs:sequence>
      <xs:element name="value" type="GenericArray"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- サンプルに出現しないセクションは引き続き汎用扱い -->
  <xs:element name="mail" type="GenericSectionType"/>
  <xs:element name="imBox" type="GenericSectionType"/>
  <xs:element name="list_pattern" type="GenericSectionType"/>
  <xs:element name="message_template" type="GenericSectionType"/>

  <!-- ============================================================ -->
  <!-- 共通ヘルパ: object 型の choice 構造を生成するための定義      -->
  <!--                                                              -->
  <!-- 各 *Object は xs:choice (min=0, max=unbounded) で            -->
  <!-- 観察されたフィールド + 必要に応じた lax フォールバックを許可 -->
  <!-- する。順序は強制しないが、出現しうる要素名を文書化する。     -->
  <!-- ============================================================ -->

  <!-- ========== contents ========== -->

  <!-- contents > value(array) > value(object) -->
  <xs:complexType name="ContentsObject">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="contentsId" type="ScalarIdString"/>
      <xs:element name="localeId" type="ScalarLocaleId"/>
      <xs:element name="contentsName" type="ScalarString"/>
      <xs:element name="contentsType" type="ScalarString"/>
      <xs:element name="note" type="ScalarString"/>
      <xs:element name="updateCount" type="ScalarString"/>
      <xs:element name="details" type="ContentsDetailsArray"/>
    </xs:choice>
    <xs:attribute name="type" type="ObjectOrNullTypeAttr" use="required"/>
  </xs:complexType>

  <xs:complexType name="ContentsArray">
    <xs:sequence>
      <xs:element name="value" type="ContentsObject" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="ArrayTypeAttr" use="required"/>
  </xs:complexType>

  <xs:complexType name="ContentsDetailObject">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="contentsId" type="ScalarIdString"/>
      <xs:element name="contentsVersionId" type="ScalarIdString"/>
      <xs:element name="localeId" type="ScalarLocaleId"/>
      <xs:element name="startDate" type="ScalarString"/>
      <xs:element name="limitDate" type="ScalarString"/>
      <xs:element name="versionStatus" type="ScalarString"/>
      <xs:element name="note" type="ScalarString"/>
      <xs:element name="pages" type="PagesArray"/>
      <xs:element name="plugins" type="ContentsPluginsArray"/>
      <xs:element name="mails" type="GenericArray"/>
      <xs:element name="rules" type="ContentsRulesArray"/>
      <xs:element name="imBoxs" type="GenericArray"/>
      <xs:element name="messages" type="GenericArray"/>
    </xs:choice>
    <xs:attribute name="type" type="ObjectOrNullTypeAttr" use="required"/>
  </xs:complexType>

  <xs:complexType name="ContentsDetailsArray">
    <xs:sequence>
      <xs:element name="value" type="ContentsDetailObject" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="ArrayTypeAttr" use="required"/>
  </xs:complexType>

  <xs:complexType name="PageObject">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="pagePathId" type="ScalarIdString"/>
      <xs:element name="localeId" type="ScalarLocaleId"/>
      <xs:element name="contentsId" type="ScalarIdString"/>
      <xs:element name="contentsVersionId" type="ScalarIdString"/>
      <xs:element name="pageName" type="ScalarString"/>
      <xs:element name="pageType" type="ScalarString"/>
      <xs:element name="note" type="ScalarString"/>
      <xs:element name="defaultFlag" type="ScalarString"/>
      <xs:element name="pathType" type="ScalarString"/>
      <xs:element name="scriptPath" type="ScalarString"/>
      <xs:element name="applicationId" type="ScalarString"/>
      <xs:element name="serviceId" type="ScalarString"/>
      <xs:element name="pagePath" type="ScalarString"/>
    </xs:choice>
    <xs:attribute name="type" type="ObjectOrNullTypeAttr" use="required"/>
  </xs:complexType>

  <xs:complexType name="PagesArray">
    <xs:sequence>
      <xs:element name="value" type="PageObject" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="ArrayTypeAttr" use="required"/>
  </xs:complexType>

  <xs:complexType name="ContentsPluginObject">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="contentsPluginId" type="ScalarIdString"/>
      <xs:element name="localeId" type="ScalarLocaleId"/>
