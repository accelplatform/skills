{
  "version": "1.0.0",
  "type": "file",
  "conditions": {
    "and": [
      {
        "accelplatformVersion": "8.0.39"
      },
      {
        "agent": "codex"
      }
    ]
  },
  "rename": [
    {
      "condition": {
        "feature": "mcp"
      },
      "from": "config.toml.with.mcp",
      "to": "config.toml"
    },
    {
      "from": "config.toml.else",
      "to": "config.toml"
    }
  ]
}
