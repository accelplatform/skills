{
  "version": "1.0.0",
  "type": "file",
  "rename": [
    {
      "condition": {
        "locale": "ja"
      },
      "from": "AGENTS_ja.md",
      "to": "AGENTS.md"
    },
    {
      "condition": {
        "locale": "zh_CN"
      },
      "from": "AGENTS_zh_CN.md",
      "to": "AGENTS.md"
    },
    {
      "from": "AGENTS_en.md",
      "to": "AGENTS.md"
    }
  ],
  "replacements": [
    {
      "type": "text",
      "target": "{{PROJECT_HEADER}}",
      "values": [
        {
          "condition": {
            "locale": "ja"
          },
          "value": "# {{$name}}\n\n- Expo SDK: {{$expoSdk}}\n- 連携先の iAP: {{$accelplatformVersion.label}}"
        },
        {
          "condition": {
            "locale": "zh_CN"
          },
          "value": "# {{$name}}\n\n- Expo SDK: {{$expoSdk}}\n- 对接的 iAP: {{$accelplatformVersion.label}}"
        },
        {
          "value": "# {{$name}}\n\n- Expo SDK: {{$expoSdk}}\n- Target iAP: {{$accelplatformVersion.label}}"
        }
      ]
    }
  ]
}
