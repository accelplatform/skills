{
  "version": "1.0.0",
  "type": "file",
  "conditions": {
    "and": [
      {
        "accelplatformVersion": ">=8.0.37"
      },
      {
        "agent": "codex"
      }
    ]
  },
  "rename": [
    {
      "condition": {
        "and": [
          {
            "javascript": false
          },
          {
            "locale": "ja"
          }
        ]
      },
      "from": "AGENTS_tssp_ja.md",
      "to": "AGENTS.md"
    },
    {
      "condition": {
        "and": [
          {
            "javascript": false
          },
          {
            "locale": "zh_CN"
          }
        ]
      },
      "from": "AGENTS_tssp_zh_CN.md",
      "to": "AGENTS.md"
    },
    {
      "condition": {
        "javascript": false
      },
      "from": "AGENTS_tssp_en.md",
      "to": "AGENTS.md"
    },
    {
      "condition": {
        "locale": "ja"
      },
      "from": "AGENTS_ja.md",
      "to": "AGENTS.md"
    },
    {
      "condition": {
        "locale": "zh_CN"
      },
      "from": "AGENTS_zh_CN.md",
      "to": "AGENTS.md"
    },
    {
      "from": "AGENTS_en.md",
      "to": "AGENTS.md"
    }
  ]
}
