#***************************
# For Archives https://github.com/github/gitignore/blob/master/Global/Archives.gitignore
#***************************
# It's better to unpack these files and commit the raw source because
# git has its own built in compression methods.
*.7z
# *.jar
*.rar
# *.zip
*.gz
*.gzip
*.tgz
*.bzip
*.bzip2
*.bz2
*.xz
*.lzma
*.cab
*.xar
*.zst
*.tzst

# Packing-only formats
*.iso
*.tar

# Package management formats
*.dmg
*.xpi
*.gem
*.egg
*.deb
*.rpm
*.msi
*.msm
*.msp
*.txz

#***************************
# For MicrosoftOffice https://github.com/github/gitignore/blob/master/Global/MicrosoftOffice.gitignore
#***************************
*.tmp

# Word temporary
~$*.doc*
~$*.dot*

# Word Auto Backup File
Backup of *.doc*

# Excel temporary
~$*.xls*

# Excel Backup File
*.xlk

# PowerPoint temporary
~$*.ppt*

# Visio autosave temporary files
*.~vsd*

#***************************
# For SVN https://github.com/github/gitignore/blob/master/Global/SVN.gitignore
#***************************
.svn/

