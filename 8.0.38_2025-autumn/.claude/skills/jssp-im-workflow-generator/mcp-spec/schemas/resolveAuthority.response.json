{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resolveAuthority Response",
  "description": "処理対象者の自然言語記述から解決されたプラグイン設定。build-workflow.js の spec.json の plugin フィールドにそのまま設定可能。",
  "type": "object",
  "required": ["suffix", "parameter", "targetType", "targetCode"],
  "properties": {
    "suffix": {
      "type": "string",
      "description": "プラグインサフィックス。標準プラグインの場合は authority-plugins.md のサフィックスと同一。カスタムの場合はユーザ拡張のサフィックス",
      "examples": ["apply_user_department_and_post", "custom_hire_date_filter"]
    },
    "extensionPointId": {
      "type": "string",
      "description": "拡張ポイントID。prevNodeType が指定された場合のみ確定値を返す。省略時は build-workflow.js が自動判定",
      "examples": [
        "jp.co.intra_mart.workflow.plugin.authority.node.apply",
        "jp.co.intra_mart.workflow.plugin.authority.node.approve",
        "jp.co.intra_mart.workflow.plugin.authority.node.approve.static",
        "jp.co.intra_mart.workflow.plugin.authority.node.dynamic",
        "jp.co.intra_mart.workflow.plugin.authority.node.confirm",
        "jp.co.intra_mart.workflow.plugin.authority.administrator.flow.handle"
      ]
    },
    "pluginId": {
      "type": "string",
      "description": "完全な pluginId。カスタムプラグインの場合は標準フォーマット（extensionPointId.suffix）と異なる場合がある",
      "examples": [
        "jp.co.intra_mart.workflow.plugin.authority.node.approve.apply_user_department_and_post",
        "jp.co.example.workflow.plugin.authority.hire_date_filter"
      ]
    },
    "parameter": {
      "type": ["string", "null"],
      "description": "プラグインパラメータ。形式はプラグイン種別による",
      "examples": [
        "|comp_sample_01^comp_sample_01^ps003",
        "im_workflow_user",
        "2026/10/01",
        null
      ]
    },
    "targetType": {
      "type": ["string", "null"],
      "description": "対象種別。動的指定系・カスタムの場合は null",
      "examples": ["role", "departmentAndPost", null]
    },
    "targetCode": {
      "type": ["string", "null"],
      "description": "対象コード。動的指定系・カスタムの場合は null",
      "examples": ["im_workflow_user", null]
    },
    "label": {
      "type": "string",
      "description": "解決結果の説明（日本語）",
      "examples": ["申請者の所属組織の課長", "2026/10/01以降に入社したユーザ"]
    },
    "isCustom": {
      "type": "boolean",
      "description": "true の場合はユーザ拡張プラグイン",
      "default": false
    },
    "notes": {
      "type": "string",
      "description": "補足事項（設定時の注意点等）"
    }
  }
}
