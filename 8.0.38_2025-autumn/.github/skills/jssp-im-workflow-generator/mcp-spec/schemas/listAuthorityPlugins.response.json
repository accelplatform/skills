{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "listAuthorityPlugins Response",
  "description": "利用可能な権限プラグインの一覧。標準 + ユーザ拡張を含む。",
  "type": "object",
  "required": ["authorityPlugins"],
  "properties": {
    "authorityPlugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authorityPluginSummary"
      }
    }
  },
  "$defs": {
    "authorityPluginSummary": {
      "type": "object",
      "required": ["suffix", "label", "category", "description"],
      "properties": {
        "suffix": {
          "type": "string",
          "description": "プラグインサフィックス。pluginId の末尾に付与される",
          "examples": ["role", "apply_user_department_and_post", "custom_hire_date_filter"]
        },
        "label": {
          "type": "string",
          "description": "プラグインの表示名（日本語）",
          "examples": ["ロール直接指定", "申請者の所属組織＋役職", "入社日フィルタ"]
        },
        "category": {
          "type": "string",
          "description": "プラグインのカテゴリ",
          "enum": ["direct", "combination", "dynamic", "custom"],
          "examples": ["direct"]
        },
        "description": {
          "type": "string",
          "description": "プラグインの機能説明（日本語）。コーディングエージェントが選択判断する材料",
          "examples": ["ロールIDを直接指定して処理対象者を決定する"]
        },
        "targetType": {
          "type": "string",
          "description": "targetType の値。空文字の場合は動的指定系",
          "examples": ["role", "departmentAndPost", ""]
        },
        "parameterFormat": {
          "type": "string",
          "description": "parameter の形式説明",
          "examples": ["{ロールID}", "|{会社コード}^{組織セットコード}^{役職コード}"]
        },
        "isCustom": {
          "type": "boolean",
          "description": "true の場合はユーザ拡張プラグイン。resolveAuthority での解決が必要な場合がある"
        }
      }
    }
  }
}
