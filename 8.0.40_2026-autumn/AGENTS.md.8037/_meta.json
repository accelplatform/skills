{
  "version": "1.0.0",
  "type": "file",
  "conditions": {
    "and": [
      {
        "accelplatformVersion": ">=8.0.37"
      },
      {
        "agent": "codex"
      }
    ]
  },
  "rename": [
    {
      "condition": {
        "locale": "ja"
      },
      "from": "AGENTS_ja.md",
      "to": "AGENTS.md"
    },
    {
      "condition": {
        "locale": "zh_CN"
      },
      "from": "AGENTS_zh_CN.md",
      "to": "AGENTS.md"
    },
    {
      "from": "AGENTS_en.md",
      "to": "AGENTS.md"
    }
  ]
}
