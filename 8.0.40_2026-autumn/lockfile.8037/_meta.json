{
  "version": "1.0.0",
  "type": "file",
  "rename": [
    {
      "condition": {
        "packageManager": "bun"
      },
      "from": "bun.lock",
      "to": "bun.lock"
    },
    {
      "condition": {
        "packageManager": "npm"
      },
      "from": "package-lock.json",
      "to": "package-lock.json"
    },
    {
      "condition": {
        "packageManager": "yarn"
      },
      "from": "yarn.lock",
      "to": "yarn.lock"
    },
    {
      "condition": {
        "packageManager": "pnpm"
      },
      "from": "pnpm-lock.yaml",
      "to": "pnpm-lock.yaml"
    }
  ]
}
