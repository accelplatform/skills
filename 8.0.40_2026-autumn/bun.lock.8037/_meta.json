{
  "version": "1.0.0",
  "type": "file",
  "conditions": {
    "accelplatformVersion": ">=8.0.37"
  },
  "rename": [
    {
      "condition": {
        "and": [
          {
            "packageManager": "bun"
          },
          {
            "module": "im_activiti"
          }
        ]
      },
      "from": "bun_im_activiti.lock",
      "to": "bun.lock"
    },
    {
      "condition": {
        "packageManager": "bun"
      },
      "from": "bun.lock",
      "to": "bun.lock"
    }
  ],
  "replacements": [
    {
      "type": "regex",
      "pattern": "\\{\\{ARTIFACT_ID\\}\\}",
      "replacement": "{{$artifactId}}",
      "condition": {
        "accelplatformVersion": "8.0.40"
      }
    }
  ]
}
