#!/usr/bin/env bash
#
# pre-commit：
#   扫描已暂存到 git 的变更内容中是否包含疑似敏感信息的字符串，
#   若检测到则阻止本次提交的 hook 脚本。
#
# 启用方法：
#   chmod +x .githooks/pre-commit
#   git config core.hooksPath .githooks
#
set -euo pipefail
shopt -s nocasematch

# =============================================================================
# 获取变更差异
# =============================================================================

# 如果按文件数逐个调用 git diff，在变更文件较多时会显著变慢，
# 因此差异获取统一合并为 1 次。
# 由于检测范围仅限于以下内容，因此通过 git 的路径规格预先筛选目标文件：
# - 记载 intra-mart OAuth 客户端密钥的 mcp 配置文件（.json / .toml）
diff_output=$(git diff --cached -U0 --diff-filter=ACM -- '*.json' '*.toml' 2>/dev/null | tr -d '\0' || true)
if [ -z "$diff_output" ]; then
  exit 0
fi

found=0
findings=()

# =============================================================================
# base64 解码函数
# =============================================================================

# 在 Git Bash (Windows) 等 fork/exec 成本较高的环境中，若按候选 token
# 数量逐一启动进程，检查动作将随候选数量增多而变慢，
# 因此 base64 解码不启动外部进程（base64/tr），仅使用 bash 内置运算完成。
# 为了在 macOS 系统自带的 /bin/bash 3.2 上也能运行，
# 不使用关联数组（bash 4.0+），改用字符串检索完成字符到数值的转换。
B64_ALPHABET="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# 将指定 base64 字符对应的 6bit 数值写入变量 B64_LAST_VAL。
# 若找不到，则将 B64_LAST_VAL 置空并返回 1。
_b64_char_value() {
  case "$1" in
    -) B64_LAST_VAL=62; return 0 ;;
    _) B64_LAST_VAL=63; return 0 ;;
  esac
  local idx="${B64_ALPHABET%%"$1"*}"
  if [ "$idx" = "$B64_ALPHABET" ]; then
    B64_LAST_VAL=""
    return 1
  fi
  B64_LAST_VAL=${#idx}
  return 0
}

# 将 token 字符串以 base64（同时兼容 urlsafe 字符集）解码，若解码结果
# 仅由 intra-mart OAuth 客户端密钥（16进制字符串 + '@' + 租户ID）所使用的
# 英数字与符号构成，则返回 true。
decode_contains_at() {
  local token="$1"
  local len=${#token}
  # 为避免循环体内每次都重新执行 local 声明带来的开销，变量统一在循环外一次性声明
  local i=0 has_at=1 c0 c1 c2 c3 v0 v1 v2 v3 nbytes val b1 b2 b3

  while (( i < len )); do
    # base64 是从「4个字符（6bit×4）」还原「3个字节（8bit×3）」的机制，
    # 因此从头开始每次截取 4 个字符进行处理。
    c0="${token:i:1}"; c1="${token:i+1:1}"; c2="${token:i+2:1}"; c3="${token:i+3:1}"
    [[ -z "$c0" || -z "$c1" ]] && break

    # 将每个字符转换为其在 base64 字母表中的位置（6bit 数值，0〜63）
    _b64_char_value "$c0" || return 1
    v0=$B64_LAST_VAL
    _b64_char_value "$c1" || return 1
    v1=$B64_LAST_VAL

    # 若第 3、4 个字符是填充符（"="）或不存在，
    # 则该分组能还原的字节数会少于 3。
    # （base64 仅末尾分组可能还原为 2 字节或 1 字节）
    nbytes=3; v2=0; v3=0
    if [[ -z "$c2" || "$c2" == "=" ]]; then
      nbytes=1
    else
      _b64_char_value "$c2" || return 1
      v2=$B64_LAST_VAL
      if [[ -z "$c3" || "$c3" == "=" ]]; then
        nbytes=2
      else
        _b64_char_value "$c3" || return 1
        v3=$B64_LAST_VAL
      fi
    fi

    # 将 4 个 6bit 数值（v0〜v3，共 24bit）合并为一个整数，
    # 再按 8bit 拆分为 3 个字节，从而还原出原始字节序列。
    #   6bit×4 = [v0][v1][v2][v3] → 8bit×3 = [b1][b2][b3]
    val=$(( (v0 * 262144) + (v1 * 4096) + (v2 * 64) + v3 ))
    b1=$(( (val / 65536) % 256 ))

    # 若出现 intra-mart OAuth 客户端密钥中不会使用的字节值，
    # 为避免误判，跳过后续判定。
    (( (b1 >= 48 && b1 <= 57) || (b1 >= 65 && b1 <= 90) || (b1 >= 97 && b1 <= 122) || b1 == 64 || b1 == 95 || b1 == 45 )) || return 1

    # 若第 1 个字节为 "@"（十进制 64），
    # 则可能是 intra-mart OAuth 客户端密钥，
    # 将 has_at 置为 0。
    (( b1 == 64 )) && has_at=0

    # 第 2、3 个字节也进行与 b1 相同的判定。
    # 但若该分组只能还原 1 个字节（nbytes=1），
    # 则 b2、b3 不存在，因此根据 nbytes 跳过判定本身。
    if (( nbytes >= 2 )); then
      b2=$(( (val / 256) % 256 ))
      (( (b2 >= 48 && b2 <= 57) || (b2 >= 65 && b2 <= 90) || (b2 >= 97 && b2 <= 122) || b2 == 64 || b2 == 95 || b2 == 45 )) || return 1
      (( b2 == 64 )) && has_at=0
    fi
    if (( nbytes >= 3 )); then
      b3=$(( val % 256 ))
      (( (b3 >= 48 && b3 <= 57) || (b3 >= 65 && b3 <= 90) || (b3 >= 97 && b3 <= 122) || b3 == 64 || b3 == 95 || b3 == 45 )) || return 1
      (( b3 == 64 )) && has_at=0
    fi

    # 一旦出现还原字节数不足 3 的分组，说明该分组即为 token 的末尾（已填充）。
    # 因此退出循环；否则继续处理下 4 个字符。
    (( nbytes < 3 )) && break
    i=$((i + 4))
  done

  # 能扫描到 token 末尾，说明该字符串仅由英数字与符号构成。
  # 期间若发现 "@"，则 has_at=0（成功），并将该值作为返回值返回。
  return "$has_at"
}

# =============================================================================
# 检查添加行中 base64 风格 token 的函数
# =============================================================================

# 用于避免重复解码同一 token 的判定结果缓存。
# 以 token 字符串本身为键，缓存传给 decode_contains_at() 后得到的判定结果。
# 不使用关联数组（bash 4.0+）。
TOKENS_MATCHED=$'\x01'
TOKENS_UNMATCHED=$'\x01'

# 从每一行添加行中，用正则表达式提取所有 40 个字符以上的 base64 风格 token，
# 并将每个 token 传给 decode_contains_at() 判定是否为 intra-mart OAuth 客户端密钥格式。
# 命中则将检测内容追加到 findings 并设置 found=1。
check_base64_tokens() {
  local file="$1" lineno="$2" content="$3"
  # 不足 40 个字符则不可能存在候选 token，在进入正则循环前直接返回。
  (( ${#content} < 40 )) && return
  local remaining="$content" token is_match

  # 若按行启动 grep 子进程，在变更文件较多时会显著变慢，
  # 因此仅使用 bash 内置正则匹配提取候选 token。
  while [[ "$remaining" =~ ([A-Za-z0-9+/_-]{40,}={0,2}) ]]; do
    token="${BASH_REMATCH[1]}"
    remaining="${remaining#*"$token"}"

    # 同一 token 可能出现在多个文件或多行中（例如将同一配置复制到多处），
    # 因此判定结果会复用缓存，但每次出现都会记录到 findings 中。
    if [[ "$TOKENS_MATCHED" == *$'\x01'"$token"$'\x01'* ]]; then
      is_match=0
    elif [[ "$TOKENS_UNMATCHED" == *$'\x01'"$token"$'\x01'* ]]; then
      is_match=1
    elif decode_contains_at "$token"; then
      TOKENS_MATCHED+="$token"$'\x01'
      is_match=0
    else
      TOKENS_UNMATCHED+="$token"$'\x01'
      is_match=1
    fi

    if (( is_match == 0 )); then
      findings+=("[$file:$lineno] 检测到 intra-mart OAuth 客户端密钥字符串: ${token:0:12}...")
      found=1
    fi
  done
}

# =============================================================================
# 检查差异中的每一行
# =============================================================================

# 由于检测范围仅限于以下内容，因此仅将下述扩展名作为检测对象。
# - 记载 intra-mart OAuth 客户端密钥的 mcp 配置文件（.json / .toml）
INCLUDE_FILE_RE='\.(json|toml)$'

# 依赖锁文件、压缩后的构建产物极少包含敏感信息，
# 且其中大量的哈希类字符串容易被误判为认证密钥，因此从扫描对象中排除。
EXCLUDE_FILE_RE='(^|/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|bun\.lock|composer\.lock|Cargo\.lock|Gemfile\.lock)$|\.(min\.js|min\.css|map)$'

current_file=""
current_line=0
is_binary=0
skip_file=0

while IFS= read -r line; do
  case "$line" in
    "diff --git "*)
      # 例如: diff --git a/path/to/file b/path/to/file
      current_file="${line#diff --git a/}"
      current_file="${current_file%% b/*}"
      is_binary=0
      if [[ "$current_file" =~ $INCLUDE_FILE_RE ]] && [[ ! "$current_file" =~ $EXCLUDE_FILE_RE ]]; then
        skip_file=0
      else
        skip_file=1
      fi
      ;;
    "Binary files "*|"GIT binary patch"*)
      is_binary=1
      ;;
    "@@ "*)
      # 例如: @@ -12,0 +13,2 @@ ...  → 获取新文件一侧的起始行号(13)
      if [[ "$line" =~ \+([0-9]+) ]]; then
        current_line="${BASH_REMATCH[1]}"
      fi
      ;;
    "+++ "*|"--- "*)
      : # 忽略 diff 头部行
      ;;
    "+"*)
      if (( is_binary == 1 || skip_file == 1 )); then
        continue
      fi
      content="${line#+}"
      check_base64_tokens "$current_file" "$current_line" "$content"
      current_line=$((current_line + 1))
      ;;
    *)
      : ;;
  esac
done <<< "$diff_output"

# =============================================================================
# 显示检测结果
# =============================================================================

if [ "$found" -eq 1 ]; then
  echo "----------------------------------------------------------------------"
  echo "🚫 已阻止提交：检测到疑似敏感信息的字符串"
  echo "----------------------------------------------------------------------"
  for msg in "${findings[@]}"; do
    echo " - $msg"
  done
  echo ""
  echo "以上位置可能包含疑似敏感信息的字符串。"
  echo "请在提交前务必确认内容，并按需删除或替换为其他字符串。"
  echo "如确认检测内容没有问题，可使用 git commit --no-verify 跳过本次检查。"
  exit 1
fi

exit 0
