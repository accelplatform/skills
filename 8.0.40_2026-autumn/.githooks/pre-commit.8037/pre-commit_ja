#!/usr/bin/env bash
#
# pre-commit:
#   git にステージされた変更内容に Authentication ヘッダや API キーに類似した文字列が
#   コード上に含まれていないかチェックし、検出時はコミットをブロックする hook スクリプト。
#
# 有効化方法:
#   chmod +x .githooks/pre-commit
#   git config core.hooksPath .githooks
#
set -euo pipefail
shopt -s nocasematch

# =============================================================================
# 変更内容の差分を取得
# =============================================================================

# ファイル数分 git diff を呼ぶと大量ファイル変更時に著しく遅くなるため、差分取得は 1回にまとめる。
# 検出対象は以下に限定するため、git diff の対象ファイルをあらかじめ絞り込む。
# - intra-mart OAuth クライアントキーが記載される mcp 設定ファイル（.json / .toml）
diff_output=$(git diff --cached -U0 --diff-filter=ACM -- '*.json' '*.toml' 2>/dev/null | tr -d '\0' || true)
if [ -z "$diff_output" ]; then
  exit 0
fi

found=0
findings=()

# =============================================================================
# base64 デコード関数
# =============================================================================

# Git Bash (Windows) 等 fork/exec が高コストな環境では、
# 候補トークン数に比例してプロセス起動が積み重なり、チェック動作が遅くなるため、
# base64 デコードは外部プロセス（base64/tr）を起動せず bash 組み込み演算のみで行う。
# macOS 標準の /bin/bash 3.2 でも動作させるため、
# 連想配列（bash 4.0+）は使わず、文字列検索で文字から値へ変換する。
B64_ALPHABET="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# 指定した base64 文字の 6bit 値を変数 B64_LAST_VAL にセットする。
# 見つからない場合は B64_LAST_VAL を空にして 1 を返却する。
_b64_char_value() {
  case "$1" in
    -) B64_LAST_VAL=62; return 0 ;;
    _) B64_LAST_VAL=63; return 0 ;;
  esac
  local idx="${B64_ALPHABET%%"$1"*}"
  if [ "$idx" = "$B64_ALPHABET" ]; then
    B64_LAST_VAL=""
    return 1
  fi
  B64_LAST_VAL=${#idx}
  return 0
}

# トークン文字列を base64（urlsafe も許容）としてデコードし、
# intra-mart OAuth クライアントキー（16 進文字列 + '@' + テナントID）で使われる英数字＋記号で
# 構成される場合に true を返却する。
decode_contains_at() {
  local token="$1"
  local len=${#token}
  # ループ内で毎回 local 宣言をやり直すコストを避けるため、変数は先に一括宣言する
  local i=0 has_at=1 c0 c1 c2 c3 v0 v1 v2 v3 nbytes val b1 b2 b3

  while (( i < len )); do
    # base64 は「4文字（6bit×4）」から「3バイト（8bit×3）」を復元する仕組みのため、
    # 先頭から4文字ずつ切り出して処理する。
    c0="${token:i:1}"; c1="${token:i+1:1}"; c2="${token:i+2:1}"; c3="${token:i+3:1}"
    [[ -z "$c0" || -z "$c1" ]] && break

    # 各文字を base64 アルファベット上の位置（6bit の値, 0〜63）に変換する
    _b64_char_value "$c0" || return 1
    v0=$B64_LAST_VAL
    _b64_char_value "$c1" || return 1
    v1=$B64_LAST_VAL

    # 3, 4文字目がパディング（"="）または存在しない場合、
    # このグループから復元できるバイト数は 3 未満になる。
    # （base64 は末尾グループのみ 2 バイト・1 バイト復元になる可能性がある）
    nbytes=3; v2=0; v3=0
    if [[ -z "$c2" || "$c2" == "=" ]]; then
      nbytes=1
    else
      _b64_char_value "$c2" || return 1
      v2=$B64_LAST_VAL
      if [[ -z "$c3" || "$c3" == "=" ]]; then
        nbytes=2
      else
        _b64_char_value "$c3" || return 1
        v3=$B64_LAST_VAL
      fi
    fi

    # 4つの 6bit 値（v0〜v3, 計 24bit）を1つの整数に結合し、
    # 8bit ずつ 3 つに割り直すことで元のバイト列を復元する。
    #   6bit×4 = [v0][v1][v2][v3] → 8bit×3 = [b1][b2][b3]
    val=$(( (v0 * 262144) + (v1 * 4096) + (v2 * 64) + v3 ))
    b1=$(( (val / 65536) % 256 ))

    # intra-mart OAuth クライアントキーで使われないバイト値が含まれている場合は、
    # 誤検知を防止するために、判定をスキップする。
    (( (b1 >= 48 && b1 <= 57) || (b1 >= 65 && b1 <= 90) || (b1 >= 97 && b1 <= 122) || b1 == 64 || b1 == 95 || b1 == 45 )) || return 1

    # 1バイト目が "@"（10 進数で 64）であれば、
    # intra-mart OAuth クライアントキーである可能性があるため、
    # has_at を 0 にする。
    (( b1 == 64 )) && has_at=0

    # 2バイト目・3バイト目についても b1 と同様の判定を行う。
    # ただし、このグループから復元できるのが 1 バイトのみ（nbytes=1）の場合は、
    # b2・b3 は存在しないため、nbytes に応じて判定自体をスキップする。
    if (( nbytes >= 2 )); then
      b2=$(( (val / 256) % 256 ))
      (( (b2 >= 48 && b2 <= 57) || (b2 >= 65 && b2 <= 90) || (b2 >= 97 && b2 <= 122) || b2 == 64 || b2 == 95 || b2 == 45 )) || return 1
      (( b2 == 64 )) && has_at=0
    fi
    if (( nbytes >= 3 )); then
      b3=$(( val % 256 ))
      (( (b3 >= 48 && b3 <= 57) || (b3 >= 65 && b3 <= 90) || (b3 >= 97 && b3 <= 122) || b3 == 64 || b3 == 95 || b3 == 45 )) || return 1
      (( b3 == 64 )) && has_at=0
    fi

    # 3バイトに満たないグループが出た時点で、それがトークンの末尾になる（パディング済み）。
    # そのため、ループを抜ける。それ以外の場合は、次の4文字へ進む。
    (( nbytes < 3 )) && break
    i=$((i + 4))
  done

  # トークン全体を最後まで走査できた場合は、文字列が英数字＋記号で構成される。
  # その中で、"@" が含まれていた場合は、has_at=0（成功）となり、その値を戻り値として返却する。
  return "$has_at"
}

# =============================================================================
# 追加行の base64 風トークンをチェックする関数
# =============================================================================

# 同一トークンの再デコードを避けるための判定結果キャッシュ。
# 検出対象の文字列を decode_contains_at() に渡した結果を、トークン文字列ごとにキャッシュする。
# 連想配列（bash 4.0+）は使用しない。
TOKENS_MATCHED=$'\x01'
TOKENS_UNMATCHED=$'\x01'

# 追加行 1行から 40文字以上の base64 風トークンを正規表現ですべて抜き出し、
# 各トークンを decode_contains_at() に渡して intra-mart OAuth クライアントキー形式かどうかを判定する。
# 該当すれば findings に検出内容を追記し found=1 をセットする。
check_base64_tokens() {
  local file="$1" lineno="$2" content="$3"
  # 40 文字未満なら候補トークンは存在しないため、処理を終了する。
  (( ${#content} < 40 )) && return
  local remaining="$content" token is_match

  # 行ごとに grep サブプロセスを起動すると、大量ファイル変更時に著しく遅くなるため、
  # bash 組み込みの正規表現マッチのみで候補トークンを抽出する。
  while [[ "$remaining" =~ ([A-Za-z0-9+/_-]{40,}={0,2}) ]]; do
    token="${BASH_REMATCH[1]}"
    remaining="${remaining#*"$token"}"

    # 同じトークンが複数ファイル・複数行に出現するケース（同じ設定を複数箇所に
    # コピーした場合等）があるため、判定結果はキャッシュを使い回しつつ、
    # 出現箇所ごとに findings へ記録する。
    if [[ "$TOKENS_MATCHED" == *$'\x01'"$token"$'\x01'* ]]; then
      is_match=0
    elif [[ "$TOKENS_UNMATCHED" == *$'\x01'"$token"$'\x01'* ]]; then
      is_match=1
    elif decode_contains_at "$token"; then
      TOKENS_MATCHED+="$token"$'\x01'
      is_match=0
    else
      TOKENS_UNMATCHED+="$token"$'\x01'
      is_match=1
    fi

    if (( is_match == 0 )); then
      findings+=("[$file:$lineno] intra-mart OAuth クライアントキー文字列を検出しました: ${token:0:12}...")
      found=1
    fi
  done
}

# =============================================================================
# 差分の各行をチェック
# =============================================================================

# 検出対象は以下に限定するため、一部の拡張子のみを対象とする。
# - intra-mart OAuth クライアントキーが記載される mcp 設定ファイル（.json / .toml）
INCLUDE_FILE_RE='\.(json|toml)$'

# 依存関係ロックファイル・minify 済み成果物は機密情報を含む可能性が低く、
# 大量のハッシュ文字列が認証キーと誤認しやすいため、スキャン対象から除外する。
EXCLUDE_FILE_RE='(^|/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|bun\.lock|composer\.lock|Cargo\.lock|Gemfile\.lock)$|\.(min\.js|min\.css|map)$'

current_file=""
current_line=0
is_binary=0
skip_file=0

while IFS= read -r line; do
  case "$line" in
    "diff --git "*)
      # 例: diff --git a/path/to/file b/path/to/file
      current_file="${line#diff --git a/}"
      current_file="${current_file%% b/*}"
      is_binary=0
      if [[ "$current_file" =~ $INCLUDE_FILE_RE ]] && [[ ! "$current_file" =~ $EXCLUDE_FILE_RE ]]; then
        skip_file=0
      else
        skip_file=1
      fi
      ;;
    "Binary files "*|"GIT binary patch"*)
      is_binary=1
      ;;
    "@@ "*)
      # 例: @@ -12,0 +13,2 @@ ...  → 新ファイル側の開始行番号 (13) を取得する
      if [[ "$line" =~ \+([0-9]+) ]]; then
        current_line="${BASH_REMATCH[1]}"
      fi
      ;;
    "+++ "*|"--- "*)
      : # diff ヘッダ行は無視
      ;;
    "+"*)
      if (( is_binary == 1 || skip_file == 1 )); then
        continue
      fi
      content="${line#+}"
      check_base64_tokens "$current_file" "$current_line" "$content"
      current_line=$((current_line + 1))
      ;;
    *)
      : ;;
  esac
done <<< "$diff_output"

# =============================================================================
# 検出結果の表示
# =============================================================================

if [ "$found" -eq 1 ]; then
  echo "----------------------------------------------------------------------"
  echo "🚫 コミットを中止しました: 機密情報に類似する文字列が検出されました"
  echo "----------------------------------------------------------------------"
  for msg in "${findings[@]}"; do
    echo " - $msg"
  done
  echo ""
  echo "上記の箇所に、機密情報に類似する文字列が含まれている可能性があります。"
  echo "コミット前に必ず内容を確認し、必要に応じて削除するか、他の文字列に置き換えてください。"
  echo "検出内容に問題がない場合は、git commit --no-verify で回避してください。"
  exit 1
fi

exit 0
