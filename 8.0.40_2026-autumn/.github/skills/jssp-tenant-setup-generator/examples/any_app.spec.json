    { "resource": "any-app-search-master", "type": "service", "action": "execute", "subject": "S(im_authz_meta_subject:authenticated)", "effect": "PERMIT" },
    { "resource": "any-app-item_select",   "type": "service", "action": "execute", "subject": "S(im_authz_meta_subject:authenticated)", "effect": "PERMIT" },

    { "resource": "REPLACE_WITH_MENU_GROUP_HASH", "type": "im-menu-group", "action": "read", "subject": "S(b_m_role:tenant_manager)", "effect": "PERMIT" },
    { "resource": "REPLACE_WITH_MENU_GROUP_HASH", "type": "im-menu-group", "action": "read", "subject": "S(b_m_role:app_manager)",    "effect": "PERMIT" }
  ],

