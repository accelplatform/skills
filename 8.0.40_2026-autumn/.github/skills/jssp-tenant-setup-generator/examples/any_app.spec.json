    { "resource": "any-app-content-maintenance",  "type": "service", "action": "execute", "subject": "S(b_m_role:app_manager)",    "effect": "PERMIT" },
    { "resource": "any-app-route-maintenance",    "type": "service", "action": "execute", "subject": "S(b_m_role:app_manager)",    "effect": "PERMIT" },
