{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "listTaskTypes Response",
  "description": "タスク種別の一覧。概要のみを含む軽量レスポンス。",
  "type": "object",
  "required": ["taskTypes"],
  "properties": {
    "taskTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskTypeSummary"
      }
    }
  },
  "$defs": {
    "taskTypeSummary": {
      "type": "object",
      "required": ["keyId", "label", "category", "description", "hasEntityId"],
      "properties": {
        "keyId": {
          "type": "string",
          "description": "タスク種別ID。getTaskTemplate の引数に使用する",
          "examples": ["im_authorizeAuthz", "im_repositorySearchEntityData"]
        },
        "label": {
          "type": "string",
          "description": "タスクの表示名（日本語）",
          "examples": ["認可判断", "エンティティデータの検索"]
        },
        "category": {
          "type": "string",
          "description": "タスクのカテゴリ。フィルタ用",
          "examples": ["認可", "リポジトリ", "フロー制御", "データ変換"]
        },
        "description": {
          "type": "string",
          "description": "タスクの機能説明（日本語）。コーディングエージェントがタスク選択を判断する材料",
          "examples": ["指定ユーザーの認可権限を判断する"]
        },
        "hasEntityId": {
          "type": "boolean",
          "description": "true の場合、spec 作成時に resolveEntitySchema の呼び出しが必要"
        }
      }
    }
  }
}
