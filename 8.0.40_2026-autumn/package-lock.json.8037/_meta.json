{
  "version": "1.0.0",
  "type": "file",
  "conditions": {
    "accelplatformVersion": ">=8.0.37"
  },
  "rename": [
    {
      "condition": {
        "and": [
          {
            "packageManager": "npm"
          },
          {
            "module": "im_activiti"
          }
        ]
      },
      "from": "package-lock_im_activiti.json",
      "to": "package-lock.json"
    },
    {
      "condition": {
        "packageManager": "npm"
      },
      "from": "package-lock.json",
      "to": "package-lock.json"
    }
  ],
  "replacements": [
    {
      "type": "regex",
      "pattern": "\\{\\{ARTIFACT_ID\\}\\}",
      "replacement": "{{$artifactId}}",
      "condition": {
        "accelplatformVersion": "8.0.40"
      }
    },
    {
      "type": "regex",
      "pattern": "\\{\\{PROJECT_VERSION\\}\\}",
      "replacement": "{{$projectVersion}}",
      "condition": {
        "accelplatformVersion": "8.0.40"
      }
    }
  ]
}
