{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "getTaskTemplate Response",
  "description": "タスク種別の完全テンプレート。build-flow.js が消費する全情報を含む。",
  "type": "object",
  "required": [
    "keyId",
    "flowElementSample",
    "cellSample",
    "dataMapMetadata",
    "dataMapMappingDefaults",
    "optionMap"
  ],
  "properties": {
    "keyId": {
      "type": "string",
      "description": "タスク種別ID"
    },
    "description": {
      "type": "string",
      "description": "タスクの機能説明（日本語）"
    },
    "flowElementSample": {
      "$ref": "#/$defs/flowElementSample",
      "description": "flowElements[] に入るタスク要素の雛形"
    },
    "cellSample": {
      "$ref": "#/$defs/cellSample",
      "description": "JointJS graph.cells[] に入るセル雛形。id/position/z は生成時に上書きされる"
    },
    "dataMapMetadata": {
      "$ref": "#/$defs/dataMapMetadata",
      "description": "dataMap[cellId].metadata の内容"
    },
    "dataMapMappingDefaults": {
      "type": "object",
      "description": "dataMap[cellId].mapping のデフォルト値",
      "required": [
        "inputKeys"
      ],
      "properties": {
        "inputKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "マッピングソース候補のデフォルト（$input, $variable, $const 等）",
          "examples": [
            [
              "$input",
              "$variable",
              "$const"
            ]
          ]
        }
      }
    },
    "optionMap": {
      "$ref": "#/$defs/optionMap",
      "description": "optionMap[cellId] の内容。title/label は生成時に上書きされる"
    }
  },
  "$defs": {
    "flowElementSample": {
      "type": "object",
      "required": [
        "executeId",
        "key",
        "properties"
      ],
      "properties": {
        "executeId": {
          "type": "string",
          "description": "サンプル executeId。生成時に連番で上書きされる"
        },
        "alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["application", "localUserDefinition"]
            },
            "id": {
              "type": "string",
              "description": "タスク種別ID（keyId と同じ値）"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "タスクのデフォルト表示ラベル"
        },
        "comment": {
          "type": "string",
          "default": ""
        },
        "properties": {
          "type": "object",
          "description": "タスク固有プロパティのデフォルト値。キーは elementProperties[].propertyName に対応",
          "additionalProperties": true
        },
        "mappingDefinition": {
          "type": "object",
          "properties": {
            "mappingRules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mappingRule"
              },
              "default": []
            }
          }
        }
      }
    },
    "cellSample": {
      "type": "object",
      "required": [
        "type",
        "size",
        "inPorts",
        "outPorts",
        "attrs"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "devs.StartModel",
            "devs.EndModel",
            "devs.ErrorModel",
            "devs.GatewayModel",
            "devs.ProcModel"
          ],
          "description": "JointJS セル種別。タスクの性質に応じて決まる"
        },
        "size": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            }
          }
        },
        "inPorts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "入力ポート名。通常は [\"in\"]"
        },
        "outPorts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "出力ポート名。通常は [\"out\"]。gateway は [\"then\",\"else\"] 等"
        },
        "id": {
          "type": "string",
          "description": "プレースホルダ UUID。生成時に上書きされる"
        },
        "z": {
          "type": "integer",
          "description": "プレースホルダ z-index。生成時に上書きされる"
        },
        "attrs": {
          "type": "object",
          "description": "JointJS attrs オブジェクト。text.title / text.label / port 定義 / rect スタイル等を含む",
          "additionalProperties": true
        }
      }
    },
    "dataMapMetadata": {
      "type": "object",
      "required": [
        "key",
        "elementProperties"
      ],
      "properties": {
        "key": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["application", "localUserDefinition"]
            },
            "id": {
              "type": "string"
            }
          }
        },
        "elementProperties": {
          "type": "array",
          "description": "タスクが持つ設定プロパティのスキーマ一覧。executeId/alias は全タスク共通で必ず含まれる",
          "items": {
            "$ref": "#/$defs/elementProperty"
          }
        },
        "inputDataDefinition": {
          "description": "タスクへの入力フィールド定義。null = 入力なし（im_start/im_end 等）。エンティティ系タスクでは entityId 未指定時のデフォルト。resolveEntitySchema で上書き可能",
          "oneOf": [
            {
              "$ref": "#/$defs/dataDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputDataDefinition": {
          "description": "タスクの出力フィールド定義。null = 出力なし。下流タスクの source.path で参照可能なフィールドを決定する",
          "oneOf": [
            {
              "$ref": "#/$defs/dataDefinition"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "optionMap": {
      "type": "object",
      "required": [
        "inNum",
        "outNum"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "プレースホルダ。生成時に executeId で上書き"
        },
        "label": {
          "type": "string",
          "description": "プレースホルダ。生成時にタスクの label で上書き"
        },
        "inNum": {
          "type": "integer",
          "description": "入力ポート数。通常は 1"
        },
        "outNum": {
          "type": "integer",
          "description": "出力ポート数。通常は 1。gateway 等は 2 以上"
        },
        "outPorts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "出力ポート名。outNum > 1 の場合に存在（例: [\"then\",\"else\"]）"
        }
      }
    },
    "elementProperty": {
      "type": "object",
      "required": [
        "propertyName",
        "enable",
        "required",
        "label"
      ],
      "properties": {
        "propertyName": {
          "type": "string",
          "description": "プロパティ名。flowElementSample.properties のキーに対応"
        },
        "enable": {
          "type": "boolean",
          "description": "UI 上で編集可能か"
        },
        "required": {
          "type": "boolean",
          "description": "必須か"
        },
        "array": {
          "type": "boolean",
          "description": "配列型か"
        },
        "type": {
          "type": "string",
          "description": "プロパティの入力タイプ。flag = チェックボックス、pulldown = プルダウン。省略時は text",
          "enum": [
            "flag",
            "text",
            "pulldown"
          ]
        },
        "label": {
          "type": "string",
          "description": "UI 表示ラベル（日本語）"
        },
        "text": {
          "type": "string",
          "description": "flag 型の場合のチェックボックスラベル"
        },
        "options": {
          "type": "array",
          "description": "flag 型の場合の選択肢定義",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "mappingRule": {
      "type": "object",
      "required": [
        "id",
        "target",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "UUID。dataMap.mapping.json.connectors[].id と一致させる"
        },
        "target": {
          "type": "string",
          "description": "出力先パス（/ 区切り）。例: im_authorizeAuthz1/userCd, $output/result"
        },
        "source": {
          "$ref": "#/$defs/mappingSource"
        }
      }
    },
    "mappingSource": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "value",
            "function"
          ],
          "description": "value = 単純参照, function = 関数呼び出し"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "function の場合: 関数名（例: im_array_size）。value の場合: null"
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "/ 区切りパス。value の場合: 参照元パス。function の場合: null"
        },
        "arguments": {
          "type": [
            "array",
            "null"
          ],
          "description": "function の場合: 引数（再帰的に mappingSource の配列）。value の場合: null",
          "items": {
            "$ref": "#/$defs/mappingSource"
          }
        }
      }
    },
    "dataDefinition": {
      "type": "object",
      "required": [
        "entrypoint",
        "typeDefinitions"
      ],
      "properties": {
        "entrypoint": {
          "$ref": "#/$defs/typeReference",
          "description": "ルート型の参照"
        },
        "typeDefinitions": {
          "type": "array",
          "description": "型定義の一覧。entrypoint.typeId から参照される",
          "items": {
            "$ref": "#/$defs/typeDefinitionEntry"
          }
        }
      }
    },
    "typeReference": {
      "type": "object",
      "required": [
        "typeId",
        "basic",
        "required",
        "listingType"
      ],
      "properties": {
        "typeId": {
          "type": "string",
          "description": "typeDefinitions[].id を参照する"
        },
        "basic": {
          "type": "boolean",
          "description": "プリミティブ型なら true"
        },
        "required": {
          "type": "boolean"
        },
        "listingType": {
          "type": "string",
          "enum": [
            "none",
            "list"
          ],
          "description": "none = 単一値, list = 配列"
        }
      }
    },
    "typeDefinitionEntry": {
      "type": "object",
      "required": [
        "id",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "型ID。プリミティブ（string/integer/boolean/long/double/bigdecimal/date/imdatetime 等）またはカスタム型。全量は reference/data-types.md 参照"
        },
        "properties": {
          "type": "array",
          "description": "この型が持つフィールド一覧。プリミティブ型の場合は空配列",
          "items": {
            "type": "object",
            "required": [
              "typeId",
              "name",
              "listingType",
              "required",
              "basic"
            ],
            "properties": {
              "typeId": {
                "type": "string",
                "description": "フィールドの型ID"
              },
              "name": {
                "type": "string",
                "description": "フィールド名"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "listingType": {
                "type": "string",
                "enum": [
                  "none",
                  "list"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "basic": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
