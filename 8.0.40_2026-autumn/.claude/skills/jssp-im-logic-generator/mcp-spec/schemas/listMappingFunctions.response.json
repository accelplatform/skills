{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "listMappingFunctions Response",
  "description": "マッピング関数の一覧。概要のみを含む軽量レスポンス。",
  "type": "object",
  "required": ["mappingFunctions"],
  "properties": {
    "mappingFunctions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mappingFunctionSummary"
      }
    }
  },
  "$defs": {
    "mappingFunctionSummary": {
      "type": "object",
      "required": ["name", "label", "category", "description", "returnType"],
      "properties": {
        "name": {
          "type": "string",
          "description": "関数名。mappingRules.source.name および connector.source.type で使用する",
          "examples": ["im_array_size", "im_substring", "im_to_integer"]
        },
        "label": {
          "type": "string",
          "description": "関数の表示名（日本語）",
          "examples": ["配列サイズ", "部分文字列", "整数変換"]
        },
        "category": {
          "type": "string",
          "description": "関数のカテゴリ。フィルタ用",
          "examples": ["配列操作", "文字列操作", "型変換", "数値演算", "日付操作", "論理演算"]
        },
        "description": {
          "type": "string",
          "description": "関数の機能説明（日本語）。コーディングエージェントが関数選択を判断する材料",
          "examples": ["配列またはリストの要素数を返す"]
        },
        "returnType": {
          "type": "string",
          "description": "戻り値の型ID",
          "examples": ["integer", "string", "boolean"]
        },
        "argCount": {
          "type": "integer",
          "description": "引数の数",
          "examples": [1, 2, 3]
        }
      }
    }
  }
}
