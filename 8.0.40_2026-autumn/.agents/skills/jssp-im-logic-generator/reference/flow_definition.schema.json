{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IM-LogicDesigner Flow Definition",
  "description": "build-flow.js が出力する flow_definition.json のスキーマ。IM-LogicDesigner にインポート可能な形式。",
  "type": "object",
  "required": [
    "flowCategories",
    "flowDefinitions"
  ],
  "properties": {
    "flowCategories": {
      "type": "array",
      "description": "カテゴリ定義",
      "items": {
        "$ref": "#/$defs/flowCategory"
      }
    },
    "flowDefinitions": {
      "type": "array",
      "description": "フロー定義。各要素は JSON.stringify されたフロー定義文字列",
      "items": {
        "type": "string",
        "description": "JSON.parse するとフロー定義オブジェクトになる"
      }
    }
  },
  "$defs": {
    "flowCategory": {
      "type": "object",
      "required": [
        "categoryId",
        "categoryName",
        "sortNumber"
      ],
      "properties": {
        "categoryId": {
          "type": "string"
        },
        "categoryName": {
          "type": "string"
        },
        "sortNumber": {
          "type": "integer"
        },
        "localizes": {
          "$ref": "#/$defs/localizes"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "flowDefinition": {
      "type": "object",
      "description": "flowDefinitions[] の各要素を JSON.parse した後のオブジェクト",
      "required": [
        "flowId",
        "version",
        "categoryId",
        "flowName",
        "localizes",
        "notes",
        "transaction",
        "validateRepositoryData",
        "mappingOrder",
        "constants",
        "variablesDataDefinition",
        "flowElements",
        "inputDataDefinition",
        "outputDataDefinition",
        "additional"
      ],
      "properties": {
        "flowId": {
          "type": "string",
          "description": "フロー識別子"
        },
        "version": {
          "type": "integer"
        },
        "categoryId": {
          "type": "string"
        },
        "flowName": {
          "type": "string"
        },
        "localizes": {
          "$ref": "#/$defs/localizes"
        },
        "notes": {
          "type": "string"
        },
        "versionComment": {
          "type": [
            "string",
            "null"
          ]
        },
        "transaction": {
          "type": "boolean"
        },
        "validateRepositoryData": {
          "type": "boolean"
        },
        "mappingOrder": {
          "type": "string",
          "enum": [
            "SOURCE_HIERARCHY",
            "TARGET_HIERARCHY"
          ]
        },
        "constants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constant"
          }
        },
        "variablesDataDefinition": {
          "$ref": "#/$defs/dataDefinition"
        },
        "inputDataDefinition": {
          "$ref": "#/$defs/dataDefinition"
        },
        "outputDataDefinition": {
          "$ref": "#/$defs/dataDefinition"
        },
        "flowElements": {
          "type": "array",
          "description": "タスク要素と sequence 要素が混在する配列",
          "items": {
            "$ref": "#/$defs/flowElement"
          }
        },
        "additional": {
          "type": "object",
          "required": [
            "ui"
          ],
          "properties": {
            "ui": {
              "type": "string",
              "description": "JSON.stringify された JointJS グラフ。JSON.parse すると additionalUi オブジェクトになる"
            }
          }
        }
      }
    },
    "flowElement": {
      "type": "object",
      "required": [
        "executeId",
        "key",
        "properties"
      ],
      "properties": {
        "executeId": {
          "type": "string",
          "description": "タスク: <keyId><連番>（例: im_authorizeAuthz1）。sequence: <from>_<to>"
        },
        "alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "application",
                "localUserDefinition"
              ],
              "description": "application = 通常タスク, localUserDefinition = ユーザ定義タスク"
            },
            "id": {
              "type": "string",
              "description": "通常タスク: タスク種別ID（im_start 等）。ユーザ定義: definitionId。sequence: im_sequence"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "description": "タスク固有プロパティ。im_sequence の場合は startPoint/endPoint/condition",
          "additionalProperties": true
        },
        "mappingDefinition": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "mappingRules"
              ],
              "properties": {
                "mappingRules": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/mappingRule"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "mappingRule": {
      "type": "object",
      "required": [
        "id",
        "target",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "UUID。additionalUi.dataMap[cellId].mapping.json.connectors[].id と一致"
        },
        "target": {
          "type": "string",
          "description": "出力先パス（/ 区切り）"
        },
        "source": {
          "$ref": "#/$defs/mappingSource"
        }
      }
    },
    "mappingSource": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "value",
            "function"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "function: 関数名, value: null"
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "value: / 区切り参照パス, function: null"
        },
        "arguments": {
          "type": [
            "array",
            "null"
          ],
          "description": "function: 引数（再帰的 mappingSource）, value: null",
          "items": {
            "$ref": "#/$defs/mappingSource"
          }
        }
      }
    },
    "additionalUi": {
      "type": "object",
      "description": "additional.ui を JSON.parse した後のオブジェクト",
      "required": [
        "version",
        "graph",
        "dataMap",
        "optionMap"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "graph": {
          "type": "object",
          "required": [
            "cells"
          ],
          "properties": {
            "cells": {
              "type": "array",
              "description": "JointJS セル。タスク用セル（StartModel/EndModel/ProcModel/GatewayModel/ErrorModel）と link セルが混在",
              "items": {
                "$ref": "#/$defs/graphCell"
              }
            }
          }
        },
        "dataMap": {
          "type": "object",
          "description": "キー = タスクセルの UUID。link セルは含まない",
          "additionalProperties": {
            "$ref": "#/$defs/dataMapEntry"
          }
        },
        "optionMap": {
          "type": "object",
          "description": "キー = タスクセルの UUID。link セルは含まない",
          "additionalProperties": {
            "$ref": "#/$defs/optionMapEntry"
          }
        }
      }
    },
    "graphCell": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "タスクセル: devs.StartModel/EndModel/ProcModel/GatewayModel/ErrorModel。接続線: link",
          "enum": [
            "devs.StartModel",
            "devs.EndModel",
            "devs.ProcModel",
            "devs.GatewayModel",
            "devs.ErrorModel",
            "devs.EmptyModel",
            "devs.LoopStartModel",
            "devs.LoopEndModel",
            "devs.CallFlowModel",
            "devs.ErrorHandlingStartModel",
            "devs.ErrorHandlingEndModel",
            "link"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "セル UUID。dataMap/optionMap のキーと一致（タスクセルの場合）"
        },
        "z": {
          "type": "integer",
          "description": "z-index（レイヤー順序）"
        },
        "size": {
          "type": "object",
          "description": "タスクセルの場合のみ",
          "properties": {
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            }
          }
        },
        "position": {
          "type": "object",
          "description": "タスクセルの場合のみ。UI上の座標",
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            }
          }
        },
        "inPorts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "タスクセルの場合のみ"
        },
        "outPorts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "タスクセルの場合のみ"
        },
        "attrs": {
          "type": "object",
          "description": "JointJS attrs。text.title.text = executeId, text.label.text = label",
          "additionalProperties": true
        },
        "source": {
          "type": "object",
          "description": "link セルの場合のみ。接続元セルの UUID とポート",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "port": {
              "type": "string"
            }
          }
        },
        "target": {
          "type": "object",
          "description": "link セルの場合のみ。接続先セルの UUID とポート",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "port": {
              "type": "string"
            }
          }
        }
      }
    },
    "dataMapEntry": {
      "type": "object",
      "required": [
        "metadata",
        "common",
        "typical",
        "mapping"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            },
            "elementProperties": {
              "type": "array",
              "description": "タスクのプロパティスキーマ一覧",
              "items": {
                "$ref": "#/$defs/elementProperty"
              }
            },
            "inputDataDefinition": {
              "oneOf": [
                {
                  "$ref": "#/$defs/dataDefinition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputDataDefinition": {
              "oneOf": [
                {
                  "$ref": "#/$defs/dataDefinition"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "common": {
          "type": "object",
          "required": [
            "executeId",
            "alias",
            "label",
            "comment"
          ],
          "properties": {
            "executeId": {
              "type": "string"
            },
            "alias": {
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "comment": {
              "type": [
                "string",
                "null"
              ]
            },
            "mapping": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "typical": {
          "type": "object",
          "description": "プロパティの実際の値",
          "additionalProperties": true
        },
        "mapping": {
          "type": "object",
          "required": [
            "inputKeys",
            "additionalKeys",
            "json"
          ],
          "properties": {
            "inputKeys": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "マッピングソース候補。$input/$variable/$const + 上流タスク executeId 等"
            },
            "additionalKeys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "json": {
              "type": "object",
              "description": "UI上のマッピング線情報。IM-LogicDesigner はこちらを読んで表示する。マッピングなしの場合は空オブジェクト {}",
              "oneOf": [
                {
                  "$ref": "#/$defs/mappingJson"
                },
                {
                  "type": "object",
                  "maxProperties": 0
                }
              ]
            }
          }
        }
      }
    },
    "mappingJson": {
      "type": "object",
      "required": [
        "version",
        "attrs",
        "connectors",
        "size"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "attrs": {
          "type": "object"
        },
        "connectors": {
          "type": "array",
          "description": "マッピング線。flowElements[].mappingDefinition.mappingRules と 1:1 対応",
          "items": {
            "$ref": "#/$defs/connector"
          }
        },
        "size": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            }
          }
        }
      }
    },
    "connector": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "対応する mappingRule.id と一致"
        },
        "source": {
          "type": "object",
          "required": [
            "id",
            "type",
            "port"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "ポート UUID"
            },
            "type": {
              "type": "string",
              "description": "value source: \"$input\"。function source: 関数名（例: im_array_size）"
            },
            "path": {
              "type": "string",
              "description": "value source のみ。TAB 区切りパス（例: $input\\tresourceURI）。function source では存在しない"
            },
            "port": {
              "type": "string",
              "description": "通常は out"
            }
          }
        },
        "target": {
          "type": "object",
          "required": [
            "id",
            "type",
            "port"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "ポート UUID"
            },
            "type": {
              "type": "string",
              "description": "出力先: \"$output\"。関数引数渡し: 関数名"
            },
            "path": {
              "type": "string",
              "description": "TAB 区切りパス（例: $output\\tresult）"
            },
            "port": {
              "type": "string",
              "description": "通常は in。複数引数の関数: in1, in2, in3 等"
            }
          }
        }
      }
    },
    "optionMapEntry": {
      "type": "object",
      "required": [
        "title",
        "label",
        "inNum",
        "outNum"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "executeId"
        },
        "label": {
          "type": "string",
          "description": "タスクの表示ラベル"
        },
        "inNum": {
          "type": "integer",
          "description": "入力ポート数"
        },
        "outNum": {
          "type": "integer",
          "description": "出力ポート数"
        },
        "outPorts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "outNum > 1 の場合の出力ポート名（例: [\"then\",\"else\"]）"
        }
      }
    },
    "elementProperty": {
      "type": "object",
      "required": [
        "propertyName",
        "enable",
        "required",
        "label"
      ],
      "properties": {
        "propertyName": {
          "type": "string"
        },
        "enable": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "array": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "flag",
            "text",
            "pulldown"
          ]
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "constant": {
      "type": "object",
      "required": [
        "name",
        "value",
        "typeId"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "typeId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "common": {
          "type": "boolean"
        }
      }
    },
    "dataDefinition": {
      "type": "object",
      "required": [
        "entrypoint",
        "typeDefinitions"
      ],
      "properties": {
        "entrypoint": {
          "$ref": "#/$defs/typeReference"
        },
        "typeDefinitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeDefinitionEntry"
          }
        }
      }
    },
    "typeReference": {
      "type": "object",
      "required": [
        "typeId",
        "basic",
        "required",
        "listingType"
      ],
      "properties": {
        "typeId": {
          "type": "string"
        },
        "basic": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "listingType": {
          "type": "string",
          "enum": [
            "none",
            "list",
            "array"
          ]
        }
      }
    },
    "typeDefinitionEntry": {
      "type": "object",
      "required": [
        "id",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "typeId",
              "name",
              "listingType",
              "basic"
            ],
            "properties": {
              "typeId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "listingType": {
                "type": "string",
                "enum": [
                  "none",
                  "list",
                  "array"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "basic": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "localizes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "locale"
        ],
        "properties": {
          "locale": {
            "type": "string"
          },
          "categoryName": {
            "type": "string"
          },
          "flowName": {
            "type": "string"
          }
        }
      }
    }
  }
}
